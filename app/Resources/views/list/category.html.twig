{% extends 'base.html.twig' %}

{% block body %}
    {{ form_start(form) }}
    {{ form_widget(form) }}
    <input type="submit" value="{{ 'action.new'|trans }}">
    {{ form_end(form) }}

    <ul>
        {% for category in categories %}
            <li>
                <a href="{{ path('category_edit', {'id': category.id}) }}">{{ category.name }}</a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
