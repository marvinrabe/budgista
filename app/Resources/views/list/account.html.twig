{% extends 'base.html.twig' %}

{% block body %}
    {{ form_start(form) }}
    {{ form_widget(form) }}
    <input type="submit" value="{{ 'action.new'|trans }}">
    {{ form_end(form) }}

    <ul>
        {% for account in accounts %}
            <li>
                <a href="{{ path('account_edit', {'id': account.id}) }}">{{ account.name }}</a>
            </li>
        {% endfor %}
    </ul>
{% endblock %}
