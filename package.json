        "axios": "^0.19",
        "cross-env": "^5.1",
        "dinero.js": "^1.6.0",
        "focus-trap": "^5.1.0",
        "laravel-mix": "^4.1.0",
        "laravel-mix-postcss-config": "^1.0.2",
        "lodash": "^4.17.13",
        "postcss": "^7.0.21",
        "postcss-load-config": "^2.1.0",
        "resolve-url-loader": "^2.3.1",
        "svelte": "^3.14.0",
        "svelte-loader": "^2.13.6",
