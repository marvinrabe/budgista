{
  "private": true,
  "engines": {
    "node": "6.11.2",
    "npm": "3.10.10"
  },
  "scripts": {
    "dev": "npm run development",
    "development": "cross-env NODE_ENV=development node_modules/webpack/bin/webpack.js --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
    "watch": "cross-env NODE_ENV=development node_modules/webpack/bin/webpack.js --watch --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
    "watch-poll": "npm run watch -- --watch-poll",
    "hot": "cross-env NODE_ENV=development node_modules/webpack-dev-server/bin/webpack-dev-server.js --inline --hot --config=node_modules/laravel-mix/setup/webpack.config.js",
    "prod": "npm run production",
    "production": "cross-env NODE_ENV=production node_modules/webpack/bin/webpack.js --progress --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
    "deployment": "cross-env NODE_ENV=production node_modules/webpack/bin/webpack.js --hide-modules --config=node_modules/laravel-mix/setup/webpack.config.js",
    "test": "mocha-webpack --webpack-config=node_modules/laravel-mix/setup/webpack.config.js --require tests/Frontend/setup.js tests/Frontend/**/*.spec.js"
  },
  "devDependencies": {
    "@fortawesome/fontawesome": "^1.0.1",
    "@fortawesome/fontawesome-free-regular": "^5.0.1",
    "@fortawesome/vue-fontawesome": "0.0.21",
    "axios": "^0.16.2",
    "babel-preset-env": "^1.6.0",
    "babel-preset-stage-3": "^6.24.1",
    "bootstrap": "^4.0.0-beta",
    "cross-env": "^5.1.1",
    "expect": "^21.2.1",
    "jquery": "^3.1.1",
    "jsdom": "^11.5.1",
    "jsdom-global": "^3.0.2",
    "laravel-mix": "^1.7.2",
    "lodash": "^4.17.4",
    "mocha": "^4.0.1",
    "mocha-webpack": "^1.0.1",
    "popper.js": "^1.13.0",
    "raven-js": "^3.21.0",
    "rrule": "^2.2.0",
    "vee-validate": "^2.0.0-rc.27",
    "vue": "^2.5.11",
    "vue-i18n": "^7.2.0",
    "vue-infinite-loading": "^2.2.3",
    "vue-router": "^2.7.0",
    "vue-test-utils": "^1.0.0-beta.8",
    "vuedraggable": "^2.15.0",
    "vuejs-datepicker": "^0.9.21",
    "vuex": "^3.0.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free-solid": "^5.0.1"
  }
}
