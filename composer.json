{
    "name": "marvinrabe/budget",
    "description": "Application to manage monthly budgets.",
    "type": "project",
    "require": {
        "php": ">=7.2",
        "ext-bcmath": "*",
        "ext-intl": "*",
        "alsofronie/eloquent-uuid": "^1.0",
        "beyondcode/laravel-websockets": "^1.1",
        "doctrine/dbal": "^2.5",
        "fideloper/proxy": "~4.0",
        "guzzlehttp/guzzle": "^6.3",
        "laravel/framework": "5.8.*",
        "laravel/tinker": "~1.0",
        "nuwave/lighthouse": "^3.5",
        "propaganistas/laravel-intl": "^3.0",
        "pusher/pusher-php-server": "^3.3",
        "rlanvin/php-rrule": "1.*",
        "sentry/sentry": "^1.7",
        "sentry/sentry-laravel": "^0.8.0",
        "spatie/laravel-cors": "^1.3",
        "tymon/jwt-auth": "1.0.0-rc.4.1"
    },
    "require-dev": {
        "filp/whoops": "~2.0",
        "fzaninotto/faker": "~1.4",
        "mll-lab/laravel-graphql-playground": "^1.0",
        "marvinrabe/laravel-graphql-test": "^0.1",
        "mockery/mockery": "0.9.*",
        "phpunit/phpunit": "~7.0"
    },
    "autoload": {
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
            ]
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "post-install-cmd": [
            "@php artisan migrate --force"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
